{
  "name": "front-data",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start:budget": "ng serve --project=budget-dataetat --configuration development",
    "start:budget-dev": "ng serve --project=budget-dataetat --proxy-config proxy.conf.json",
    "start:france-relance": "ng serve --project=france-relance",
    "start:france-relance-dev": "ng serve --project=france-relance --proxy-config proxy.conf.json --port=5006",
    "start:data-qpv": "ng serve --project=data-qpv",
    "start:data-qpv-dev": "ng serve --project=data-qpv --proxy-config proxy.conf.json",
    "build:budget": "ng build --project=budget-dataetat",
    "build:budget-dev": "ng build --project=budget-dataetat --output-path=dist/budget-dataetat-dev/",
    "build:france-relance": "ng build --project=france-relance",
    "build:data-qpv": "ng build --project=data-qpv",
    "build:all": "ng build --project=france-relance && ng build --project=data-qpv",
    "lint": "eslint --max-warnings 55",
    "knip": "knip"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.19",
    "@angular/cdk": "^21.0.0",
    "@angular/common": "^21.2.19",
    "@angular/compiler": "^21.2.19",
    "@angular/core": "^21.2.19",
    "@angular/forms": "^21.2.19",
    "@angular/material": "^21.0.0",
    "@angular/platform-browser": "^21.2.19",
    "@angular/platform-browser-dynamic": "^21.2.19",
    "@angular/router": "^21.2.19",
    "@edugouvfr/ngx-dsfr-ext": "^1.6.2",
    "@gouvfr/dsfr": "~1.14.4",
    "chart.js": "4.5.1",
    "geoportal-extensions-openlayers": "^3.4.6",
    "keycloak-angular": "^21.0.0",
    "keycloak-js": "^25.0.6",
    "ngx-matomo-client": "~9.1.0",
    "ol": "^10.2.1",
    "ol-mapbox-style": "^13.0.0",
    "rxjs": "~7.8.0",
    "topojson-client": "^3.1.0",
    "tslib": "^2.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.20",
    "@angular-eslint/builder": "21.4.0",
    "@angular-eslint/eslint-plugin": "21.4.0",
    "@angular-eslint/eslint-plugin-template": "21.4.0",
    "@angular-eslint/schematics": "21.4.0",
    "@angular-eslint/template-parser": "21.4.0",
    "@angular/build": "^21.2.20",
    "@angular/cli": "^21.2.20",
    "@angular/compiler-cli": "^21.2.19",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.23.0",
    "@playwright/test": "^1.58.2",
    "@types/arcgis-rest-api": "^10.4.8",
    "@types/jasmine": "~6.0.0",
    "@types/topojson-specification": "^1.0.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.17.0",
    "globals": "^17.0.0",
    "ng-packagr": "^21.0.0",
    "tus-js-client": "^4.3.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.28.0",
    "knip": "^6.11.0"
  },
  "overrides": {
    "browser-sync": "^3.0.2",
    "inflight": "npm:@npmcli/fs@^6.0.0",
    "rimraf": "^6.0.1",
    "glob": "^13.0.3"
  }
}
